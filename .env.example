# LLM Google Gemini (obtén tu llave gratis en https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Opcional: Supabase (para base de datos y simulación de APIs en la nube)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-de-supabase

# API Keys para simulación local de cada sistema
ATHENEA_API_KEY=athenea-dev-key
IMEDICAL_API_KEY=imedical-dev-key
SAGICC_API_KEY=sagicc-dev-key

# Latencia simulada en milisegundos (0 para local rápido, 300 para realismo de red)
MOCK_LATENCY_MS=0
